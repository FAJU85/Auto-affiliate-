{
  "name": "auto-affiliate",
  "version": "1.0.0",
  "description": "Autonomous affiliate marketing pipeline: Admitad → AI → Bluesky",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test $(find src -name '*.test.js' | tr '\\n' ' ')",
    "test:e2e": "node --test tests/e2e/schedule-manager.test.js tests/e2e/api.test.js",
    "test:ui": "node --test tests/e2e/dashboard.test.js",
    "test:all": "npm test && npm run test:e2e",
    "status": "node src/cli/status.js"
  },
  "dependencies": {
    "@atproto/api": "^0.20.9",
    "@atproto/oauth-client-node": "^0.4.1",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.52.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "puppeteer": "^25.1.0"
  }
}
