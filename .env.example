# Admitad XML Feed (no OAuth — full URL from Admitad webmaster panel)
# Format: https://export.admitad.com/en/webmaster/websites/{id}/products/export_adv_products/?user=...&code=...&format=xml&feed_id=...
ADMITAD_FEED_URL=https://export.admitad.com/en/webmaster/websites/YOUR_WEBSITE_ID/products/export_adv_products/?user=YOUR_USER&code=YOUR_CODE&format=xml&feed_id=YOUR_FEED_ID&last_import=

# Takeads CPC network (optional — https://takeads.com)
TAKEADS_API_KEY=

# Groq (text generation — FREE, llama-3.3-70b-versatile, 14,400 req/day free tier)
# Sign up: https://console.groq.com
GROQ_API_KEY=gsk_...

# DeepSeek Chat (paid fallback, only used if Groq fails — ~$0.0002/call)
DEEPSEEK_API_KEY=sk-...

# HuggingFace (image upscaling — free community tier)
HF_API_TOKEN=hf_...

# LangSearch (image fallback search — optional)
LANGSEARCH_API_KEY=your_key

# Bluesky
BSKY_HANDLE=yourhandle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Budget guardrails (DeepSeek cost only — ~$0.012/day)
DAILY_COST_CAP_USD=2.00
ALERT_COST_THRESHOLD_USD=1.50

# Pipeline config
CRON_SCHEDULE=0 * * * *
MIN_COMMISSION_RATE=0.10
MAX_POST_LENGTH=300
TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=US
